boot							/boot		mtd	defaults								recoveryonly

/dev/block/wave_sd_system				/system		ext4	ro									wait
/dev/block/wave_sd_cache				/cache		ext4	noatime,nosuid,nodev							wait
/dev/block/wave_sd_data					/data		f2fs	noatime,nosuid,nodev,background_gc=on,inline_xattr,flush_merge	wait

/devices/platform/s3c-sdhci.2/mmc_host/mmc2 	auto 		auto	defaults								voldmanaged=sdcard1:wave_sd_storage

/dev/block/zram0					none		swap	defaults								zramsize=125829120
