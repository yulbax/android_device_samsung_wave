on fs
    mount_all fstab.wave

    mkdir /boot 0755 root root
    mount vfat /dev/block/wave_sd_boot /boot nosuid nodev noexec noatime shortname=mixed,utf8,fmask=0133,dmask=0022

    write /sys/block/zram0/comp_algorithm lz4
    write /sys/block/zram0/max_comp_streams 1
    swapon_all fstab.wave

    write /sys/block/mmcblk0/queue/read_ahead_kb 512
    write /sys/block/mmcblk1/queue/read_ahead_kb 512
