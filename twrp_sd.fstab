/data 		f2fs	/dev/block/wave_sd_data 	flags=backup=1;canbewiped;wipeingui;wipeduringfactoryreset
/cache		ext4	/dev/block/wave_sd_cache	flags=backup=1;canbewiped;wipeingui;wipeduringfactoryreset
/system	ext4	/dev/block/wave_sd_system	flags=backup=1;canbewiped;wipeingui

/boot		vfat	/dev/block/wave_sd_boot		flags=display="Boot (boot.img)";backup=1
/external_sd	vfat	/dev/block/wave_sd_storage	flags=display="External SD Card";storage;wipeingui;removable
