/data 		ext4	/dev/block/wave_sd_data 	length=-16384 flags=backup=1;canbewiped;wipeingui;wipeduringfactoryreset
/cache		ext4	/dev/block/wave_sd_cache	flags=backup=1;canbewiped;wipeingui;wipeduringfactoryreset
/system	ext4	/dev/block/wave_sd_system	flags=backup=1;canbewiped;wipeingui

/external_sd	vfat	/dev/block/wave_sd_storage	flags=display="External SD Card";storage;removable
